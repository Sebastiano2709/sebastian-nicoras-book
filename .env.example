# Names only — real values live in Vercel's environment settings, separately for Preview and Production
# (10 §17A.2). Never commit .env files.
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require   # Neon, EU region, one branch per environment
REDIS_URL=rediss://default:password@host:6379                        # Upstash, EU region — required in production
RESEND_API_KEY=
CONTACT_TO_EMAIL=sebastiano.nicoras@gmail.com
CONTACT_FROM_EMAIL="Sebastiano Nicoras <noreply@notify.YOUR-DOMAIN>"  # verified sending subdomain (10 §17A.4)
CLIENT_IP_SOURCE=vercel
CRON_SECRET=generate-at-least-32-random-characters
RETENTION_DAYS=365                                                   # [LEGAL] enquiry retention, owner confirms
NEXT_PUBLIC_SITE_URL=https://sebastiano-nicoras.vercel.app           # production origin; the custom domain once DNS is live
NEXT_PUBLIC_GA_ID=                                                   # G-CGNJVQNKZS in Production ONLY; empty = no banner, no GA
SITE_ENV=development
HSTS_MAX_AGE=86400
